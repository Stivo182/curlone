#Использовать "../../src/public"
#Использовать "../../src/generation"
#Использовать "../../src/generators/platform-http"
#Использовать "../../src/generators/connector-http"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("1c", "-H 'User-Agent: custom' -A ''", "User-Agent", "custom")
&ИсточникЗначение("connector", "-H 'User-Agent: custom' -A ''", "User-Agent", "custom")
&ИсточникЗначение("1c", "-A '' -H 'User-Agent: custom'", "User-Agent", "custom")
&ИсточникЗначение("connector", "-A '' -H 'User-Agent: custom'", "User-Agent", "custom")
&ИсточникЗначение("1c", "-H 'uSeR-aGeNt: custom' -A ''", "uSeR-aGeNt", "custom")
&ИсточникЗначение("connector", "-H 'uSeR-aGeNt: custom' -A ''", "uSeR-aGeNt", "custom")
&ИсточникЗначение("1c", "-H 'User-Agent;' -A ''", "User-Agent", "")
&ИсточникЗначение("connector", "-H 'User-Agent;' -A ''", "User-Agent", "")
&ИсточникЗначение("1c", "-A '' -H 'User-Agent;'", "User-Agent", "")
&ИсточникЗначение("connector", "-A '' -H 'User-Agent;'", "User-Agent", "")
&ИсточникЗначение("1c", "-H 'User-Agent: custom' -A 'other'", "User-Agent", "custom")
&ИсточникЗначение("connector", "-H 'User-Agent: custom' -A 'other'", "User-Agent", "custom")
&ИсточникЗначение("1c", "-A '' -A 'new'", "User-Agent", "new")
&ИсточникЗначение("connector", "-A '' -A 'new'", "User-Agent", "new")
Процедура ТестДолжен_СохранитьИтоговыйПользовательскийАгентБезЛожныхПредупреждений(Цель, Опции, Имя, Значение) Экспорт

	// Подготовка
	Параметры = Новый ПараметрыКонвертацииCURL("curl " + Опции + " http://example.com/");
	Параметры.Цель = Цель;
	ОжидаемыйКод = "Заголовки = Новый Соответствие();
	|Заголовки.Вставить(""" + Имя + """, """ + Значение + """);
	|
	|";

	Если Цель = "1c" Тогда
		ОжидаемыйКод = ОжидаемыйКод + "Соединение = Новый HTTPСоединение(""example.com"", 80);
		|HTTPЗапрос = Новый HTTPЗапрос(""/"", Заголовки);
		|
		|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";
	Иначе
		ОжидаемыйКод = ОжидаемыйКод + "ДополнительныеПараметры = Новый Структура();
		|ДополнительныеПараметры.Вставить(""Заголовки"", Заголовки);
		|
		|Результат = КоннекторHTTP.Get(""http://example.com"", , ДополнительныеПараметры);";
	КонецЕсли;

	// Действие
	Результат = Новый КонвертерCURL().Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("1c", "-H 'User-Agent:' -A 'custom'")
&ИсточникЗначение("connector", "-H 'User-Agent:' -A 'custom'")
&ИсточникЗначение("1c", "-A 'custom' -H 'User-Agent:'")
&ИсточникЗначение("connector", "-A 'custom' -H 'User-Agent:'")
&ИсточникЗначение("1c", "-A 'old' -A ''")
&ИсточникЗначение("connector", "-A 'old' -A ''")
Процедура ТестДолжен_СохранитьПодавлениеПользовательскогоАгента(Цель, Опции) Экспорт

	// Подготовка
	Параметры = Новый ПараметрыКонвертацииCURL("curl " + Опции + " http://example.com/");
	Параметры.Цель = Цель;

	Если Цель = "1c" Тогда
		ОжидаемыйКод = "Соединение = Новый HTTPСоединение(""example.com"", 80);
		|HTTPЗапрос = Новый HTTPЗапрос(""/"");
		|
		|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";
	Иначе
		ОжидаемыйКод = "Результат = КоннекторHTTP.Get(""http://example.com"");";
	КонецЕсли;

	// Действие
	Результат = Новый КонвертерCURL().Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(?(Цель = "1c", 0, 1));

	Если Цель = "connector" Тогда
		Ожидаем.Что(Результат.Предупреждения()[0].ИдентификаторВозможности()).Равно("headers.remove");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
