#Использовать "../../src/public"
#Использовать "../../src/generation"
#Использовать "../../src/generators/platform-http"
#Использовать "../../src/generators/connector-http"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("1c", "ru", "PROPFIND")
&ИсточникЗначение("1c", "en", "PROPFIND")
&ИсточникЗначение("connector", "ru", "PROPFIND")
&ИсточникЗначение("connector", "en", "PROPFIND")
&ИсточникЗначение("1c", "ru", "REPORT")
&ИсточникЗначение("1c", "en", "REPORT")
&ИсточникЗначение("connector", "ru", "REPORT")
&ИсточникЗначение("connector", "en", "REPORT")
Процедура ТестДолжен_ВызватьНестандартныйМетодБезТела(Цель, Локаль, Метод) Экспорт

	// Подготовка
	Параметры = Новый ПараметрыКонвертацииCURL("curl -X " + Метод + " http://example.com/");
	Параметры.Цель = Цель;
	Параметры.Локаль = Локаль;

	Если Цель = "1c" И Локаль = "ru" Тогда
		ОжидаемыйКод = "Соединение = Новый HTTPСоединение(""example.com"", 80);
		|HTTPЗапрос = Новый HTTPЗапрос(""/"");
		|
		|HTTPОтвет = Соединение.ВызватьHTTPМетод(""" + Метод + """, HTTPЗапрос);";
	ИначеЕсли Цель = "1c" Тогда
		ОжидаемыйКод = "Connection = New HTTPConnection(""example.com"", 80);
		|HTTPRequest = New HTTPRequest(""/"");
		|
		|HTTPResponse = Connection.CallHTTPMethod(""" + Метод + """, HTTPRequest);";
	ИначеЕсли Локаль = "ru" Тогда
		ОжидаемыйКод = "ДополнительныеПараметры = Новый Структура();
		|
		|Результат = КоннекторHTTP.ВызватьМетод(""" + Метод + """, ""http://example.com"", ДополнительныеПараметры);";
	Иначе
		ОжидаемыйКод = "AdditionalParameters = New Structure();
		|
		|Result = HTTPConnector.CallMethod(""" + Метод + """, ""http://example.com"", AdditionalParameters);";
	КонецЕсли;

	// Действие
	Результат = Новый КонвертерCURL().Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("1c", "ru", "PROPFIND")
&ИсточникЗначение("1c", "en", "PROPFIND")
&ИсточникЗначение("connector", "ru", "PROPFIND")
&ИсточникЗначение("connector", "en", "PROPFIND")
&ИсточникЗначение("1c", "ru", "MKCOL")
&ИсточникЗначение("1c", "en", "MKCOL")
&ИсточникЗначение("connector", "ru", "MKCOL")
&ИсточникЗначение("connector", "en", "MKCOL")
Процедура ТестДолжен_ПередатьТелоЗаголовкиИПараметрыНестандартномуМетоду(Цель, Локаль, Метод) Экспорт

	// Подготовка
	Параметры = Новый ПараметрыКонвертацииCURL("curl -X " + Метод
		+ " --data-raw payload -H 'Content-Type: text/plain' 'http://example.com/?q=one'");
	Параметры.Цель = Цель;
	Параметры.Локаль = Локаль;

	Если Цель = "1c" И Локаль = "ru" Тогда
		ОжидаемыйКод = "Заголовки = Новый Соответствие();
		|Заголовки.Вставить(""Content-Type"", ""text/plain"");
		|
		|Соединение = Новый HTTPСоединение(""example.com"", 80);
		|HTTPЗапрос = Новый HTTPЗапрос(""/?q=one"", Заголовки);
		|HTTPЗапрос.УстановитьТелоИзСтроки(""payload"");
		|
		|HTTPОтвет = Соединение.ВызватьHTTPМетод(""" + Метод + """, HTTPЗапрос);";
	ИначеЕсли Цель = "1c" Тогда
		ОжидаемыйКод = "Headers = New Map();
		|Headers.Insert(""Content-Type"", ""text/plain"");
		|
		|Connection = New HTTPConnection(""example.com"", 80);
		|HTTPRequest = New HTTPRequest(""/?q=one"", Headers);
		|HTTPRequest.SetBodyFromString(""payload"");
		|
		|HTTPResponse = Connection.CallHTTPMethod(""" + Метод + """, HTTPRequest);";
	ИначеЕсли Локаль = "ru" Тогда
		ОжидаемыйКод = "ПараметрыЗапроса = Новый Соответствие();
		|ПараметрыЗапроса.Вставить(""q"", ""one"");
		|
		|Заголовки = Новый Соответствие();
		|Заголовки.Вставить(""Content-Type"", ""text/plain"");
		|
		|ДополнительныеПараметры = Новый Структура();
		|ДополнительныеПараметры.Вставить(""Заголовки"", Заголовки);
		|ДополнительныеПараметры.Вставить(""ПараметрыЗапроса"", ПараметрыЗапроса);
		|ДополнительныеПараметры.Вставить(""Данные"", ""payload"");
		|
		|Результат = КоннекторHTTP.ВызватьМетод(""" + Метод + """, ""http://example.com"", ДополнительныеПараметры);";
	Иначе
		ОжидаемыйКод = "QueryString = New Map();
		|QueryString.Insert(""q"", ""one"");
		|
		|Headers = New Map();
		|Headers.Insert(""Content-Type"", ""text/plain"");
		|
		|AdditionalParameters = New Structure();
		|AdditionalParameters.Insert(""Headers"", Headers);
		|AdditionalParameters.Insert(""RequestParameters"", QueryString);
		|AdditionalParameters.Insert(""Data"", ""payload"");
		|
		|Result = HTTPConnector.CallMethod(""" + Метод + """, ""http://example.com"", AdditionalParameters);";
	КонецЕсли;

	// Действие
	Результат = Новый КонвертерCURL().Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(0);

КонецПроцедуры

#КонецОбласти
