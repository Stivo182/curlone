#Использовать "../../src/public"
#Использовать "../../src/generation"
#Использовать "../../src/generators/platform-http"
#Использовать "../../src/generators/connector-http"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("1c")
&ИсточникЗначение("connector")
Процедура ТестДолжен_ОтклонитьЧастичноРаскрытыйШаблонЗагрузки(Цель) Экспорт

	// Подготовка
	Параметры = Новый ПараметрыКонвертацииCURL("curl -T '{a,b}{1,2}.txt' https://example.com/");
	Параметры.Цель = Цель;
	ОжидаемаяДиагностика = Новый Массив;
	ОжидаемаяДиагностика.Добавить(Новый Структура(
		"Вид, Код, Сообщение, ИдентификаторВозможности, ИсходнаяОпция, Позиция, ИдентификаторГенератора",
		ВидыДиагностикиКонвертацииCURL.Ошибка(),
		КодыОшибокCurlone.НеподдерживаемыйИсточникНесколькихПередач(),
		"Шаблон имени файла создаёт несколько файлов для одного запроса. Такая команда не поддерживается.",
		Неопределено,
		Неопределено,
		6,
		Неопределено
	));

	// Действие
	Результат = Новый КонвертерCURL().Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
	Ожидаем.Что(Результат.Код()).Равно("");
	Ожидаем.Что(Результат.ИдентификаторГенератора()).Равно(Цель);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(1);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(0);
	Ожидаем.Что(Результат.Диагностика()).РавноМассиву(ОжидаемаяДиагностика);

КонецПроцедуры

#КонецОбласти
