#Использовать asserts
#Использовать "../../src/web"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("target", "Поле target должно быть строкой")
&ИсточникЗначение("locale", "Поле locale должно быть строкой")
&ИсточникЗначение("generatorOptions", "Поле generatorOptions должно быть объектом")
Процедура ТестДолжен_ОтклонитьЯвныйNullВНеобязательномПоле(ИмяПоля, Сообщение) Экспорт

	// Подготовка
	Тело = "{""command"":""curl http://example.com"", """ + ИмяПоля + """:null}";
	Проверка = Новый ПроверкаЗапросаКонвертацииJSON;
	Разбор = Проверка.Разобрать(Тело);

	// Действие
	Результат = Проверка.ПроверитьДанные(Разбор.Данные);

	// Проверка
	Ожидаем.Что(Результат).ИмеетТип("Структура");
	Ожидаем.Что(Результат.Статус).Равно(400);
	Ожидаем.Что(Результат.ТекстСтатуса).Равно("Bad Request");
	Ошибка = ДиагностикаОшибок.ЭффективнаяОшибка(Результат.Ошибка);
	Ожидаем.Что(Ошибка.КодОшибки()).Равно("argument.invalid_type");
	Ожидаем.Что(Ошибка.Сообщение()).Равно(Сообщение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение(", ""generatorOptions"":{}")
&ИсточникЗначение(", ""generatorOptions"":{""responseDeserializationFormat"":null}")
&ИсточникЗначение(", ""target"":""connector"", ""locale"":""en""")
Процедура ТестДолжен_ПриниматьДопустимыеНеобязательныеПоля(Поля) Экспорт

	// Подготовка
	Тело = "{""command"":""curl http://example.com""" + Поля + "}";
	Проверка = Новый ПроверкаЗапросаКонвертацииJSON;
	Разбор = Проверка.Разобрать(Тело);

	// Действие
	Результат = Проверка.ПроверитьДанные(Разбор.Данные);

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("garbage")
&ИсточникЗначение("{}")
&ИсточникЗначение("[]")
&ИсточникЗначение("null")
Процедура ТестДолжен_ОтклонитьДанныеПослеКорневогоОбъектаJSON(Остаток) Экспорт

	// Подготовка
	Тело = "{""command"":""curl http://example.com""} " + Остаток;

	// Действие
	Результат = Новый ПроверкаЗапросаКонвертацииJSON().Разобрать(Тело);

	// Проверка
	Ожидаем.Что(Результат.Данные).Равно(Неопределено);
	Ожидаем.Что(Результат.Ошибка.Статус).Равно(400);
	Ожидаем.Что(Результат.Ошибка.ТекстСтатуса).Равно("Bad Request");
	Ошибка = ДиагностикаОшибок.ЭффективнаяОшибка(Результат.Ошибка.Ошибка);
	Ожидаем.Что(Ошибка.КодОшибки()).Равно("data.invalid");
	Ожидаем.Что(Ошибка.Сообщение()).Равно("Тело запроса содержит неверный JSON");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьПробельныеСимволыПослеОбъектаJSON() Экспорт

	// Подготовка
	Тело = "{""command"":""curl http://example.com""} " + Символы.ВК + Символы.ПС + Символы.Таб;

	// Действие
	Результат = Новый ПроверкаЗапросаКонвертацииJSON().Разобрать(Тело);

	// Проверка
	Ожидаем.Что(Результат.Ошибка).Равно(Неопределено);
	Ожидаем.Что(Результат.Данные.Количество()).Равно(1);
	Ожидаем.Что(Результат.Данные.Получить("command")).Равно("curl http://example.com");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьОбъявленныйРазмерНеподготовленногоТела() Экспорт

	// Подготовка
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Length", "65537");
	Запрос = Новый Структура("Заголовки,Тело,ТелоДвоичныеДанные", Заголовки, "", Неопределено);

	// Действие
	Размер = Новый ПроверкаЗапросаКонвертацииJSON().РазмерТела(Запрос);

	// Проверка
	Ожидаем.Что(Размер).Равно(65537);

КонецПроцедуры

#КонецОбласти
