&ПараметризованныйТест
&ИсточникЗначение(65536, 200)
&ИсточникЗначение(65537, 413)
Процедура ТестДолжен_СоблюдатьГраницуРазмераТела(Размер, Статус) Экспорт

	// Подготовка
	Основа = "{""command"":""curl http://example.com""}";
	Тело = СтрокаРазмером(Основа, Размер);

	Если Статус = 200 Тогда
		ОжидаемыеДанные = ОжидаемыйУспешныйОтвет("1c", КодGETДляExampleCom());
	Иначе
		ОжидаемыеДанные = ОжидаемыйОтветСОшибкой("data.too_large", "Тело запроса превышает 65536 байт");
	КонецЕсли;

	// Действие
	Ответ = ОтправитьJSON(Тело);

	// Проверка
	ПроверитьПолныйJSONОтвет(Ответ, ОжидаемыеДанные, Статус);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(65536, 200, Ложь)
&ИсточникЗначение(65537, 413, Ложь)
&ИсточникЗначение(65536, 200, Истина)
Процедура ТестДолжен_СоблюдатьГраницуРазмераТелаПриПередачеЧастями(Размер, Статус, ПоОдномуБайту) Экспорт

	// Подготовка
	Тело = СтрокаРазмером("{""command"":""curl http://example.com""}", Размер);
	ПереводСтроки = Символы.ВК + Символы.ПС;
	РазмерUTF8 = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь).Размер();
	Ожидаем.Что(РазмерUTF8, "Размер тела без обвязки передачи частями").Равно(Размер);

	Если ПоОдномуБайту Тогда
		Порции = Новый Массив;

		Для Индекс = 1 По Размер Цикл
			Порции.Добавить("1" + ПереводСтроки + Сред(Тело, Индекс, 1) + ПереводСтроки);
		КонецЦикла;

		Части = СтрСоединить(Порции);
	Иначе
		Части = "8000" + ПереводСтроки + Лев(Тело, 32768) + ПереводСтроки
			+ "8000" + ПереводСтроки + Сред(Тело, 32769, 32768) + ПереводСтроки;
	КонецЕсли;

	Если Размер > 65536 Тогда
		Части = Части + "1" + ПереводСтроки + Прав(Тело, 1) + ПереводСтроки;
	КонецЕсли;

	Части = Части + "0" + ПереводСтроки + ПереводСтроки;

	Если Статус = 200 Тогда
		ОжидаемыеДанные = ОжидаемыйУспешныйОтвет("1c", КодGETДляExampleCom());
	Иначе
		ОжидаемыеДанные = ОжидаемыйОтветСОшибкой("data.too_large", "Тело запроса превышает 65536 байт");
	КонецЕсли;

	// Действие
	ДанныеОтвета = ОтправитьТелоЧастями(Части);

	// Проверка
	ПроверитьОтветНаПередачуЧастями(ДанныеОтвета, ОжидаемыеДанные, Статус);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничиватьРазмерОбвязкиПередачиЧастями() Экспорт

	// Подготовка
	ПереводСтроки = Символы.ВК + Символы.ПС;
	Части = "1;" + СтрокаРазмером("padding=", 1048576) + ПереводСтроки
		+ "{" + ПереводСтроки + "0" + ПереводСтроки + ПереводСтроки;
	ОжидаемыеДанные = ОжидаемыйОтветСОшибкой("data.too_large", "Тело запроса превышает 65536 байт");

	// Действие
	ДанныеОтвета = ОтправитьТелоЧастями(Части);

	// Проверка
	ПроверитьОтветНаПередачуЧастями(ДанныеОтвета, ОжидаемыеДанные, 413);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БезопасноОтклонятьНеверныйРазмерЧастиТела() Экспорт

	// Подготовка
	ПереводСтроки = Символы.ВК + Символы.ПС;
	Части = "не число" + ПереводСтроки + "{" + ПереводСтроки + "0" + ПереводСтроки + ПереводСтроки;
	ОжидаемыеДанные = ОжидаемыйОтветСОшибкой("data.invalid", "Не удалось прочитать тело запроса");

	// Действие
	ДанныеОтвета = ОтправитьТелоЧастями(Части);

	// Проверка
	ПроверитьОтветНаПередачуЧастями(ДанныеОтвета, ОжидаемыеДанные, 400);

КонецПроцедуры

