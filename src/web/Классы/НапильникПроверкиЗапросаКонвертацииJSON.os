#Использовать decorator
#Использовать errors

Перем _Поделка; // Поделка
Перем _ПроверкаЗапроса; // ПроверкаЗапросаКонвертацииJSON
Перем _ФормированиеОтвета; // ФормированиеОтветаКонвертацииJSON

#Область ОбработчикиСобытий

// Создаёт напильник для проверки JSON до автоматического разбора Winow.
//
// Параметры:
//   Поделка - Поделка - Приложение Autumn для получения фабрики ответов.
&Напильник(ПрименяетсяТолькоНа = "ОбработчикЗапросов")
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") Поделка)

	_Поделка = Поделка;
	_ПроверкаЗапроса = Новый ПроверкаЗапросаКонвертацииJSON;
	_ФормированиеОтвета = Новый ФормированиеОтветаКонвертацииJSON;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет предварительную проверку в обработчик запросов Winow.
//
// Параметры:
//   Желудь            - ОбработчикЗапросов - Исходный обработчик запросов.
//   ОпределениеЖелудя - ОпределениеЖелудя  - Описание компонента Autumn.
//
// Возвращаемое значение:
//   Произвольный - Декоратор обработчика запросов.
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт // BSLLS:UnusedParameters-off

	ТелоПерехватчика = "
	|Декоратор_ПредварительныйОтвет = Декоратор_ПроверкаJSON.ПредварительныйОтвет(Запрос);
	|
	|Если Декоратор_ПредварительныйОтвет <> Неопределено Тогда
	|	Возврат Декоратор_ПредварительныйОтвет;
	|КонецЕсли;";

	Перехватчик = Новый Перехватчик("СформироватьОтвет")
		.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
		.Тело(ТелоПерехватчика);

	Построитель = Новый ПостроительДекоратора(Желудь)
		.Поле(Новый Поле("Декоратор_ПроверкаJSON"))
		.Перехватчик(Перехватчик);

	Декоратор = Построитель.Построить();

	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Декоратор, "Декоратор_ПроверкаJSON", ЭтотОбъект);

	Возврат Декоратор;

КонецФункции

// Проверяет метод, тип содержимого, размер и синтаксис JSON до автоматического разбора тела Winow.
// Ограничивает чтение потока и возвращает безопасную ошибку при сбое чтения.
//
// Параметры:
//   Запрос - ВходящийЗапрос - Входящий HTTP-запрос.
//
// Возвращаемое значение:
//   Ответ, Неопределено - Готовый ответ при нарушении ограничений или Неопределено.
Функция ПредварительныйОтвет(Запрос) Экспорт

	Если Не ЭтоЦелевойЗапрос(Запрос) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ВРег(Запрос.Метод) <> "POST" Тогда
		Ответ = ОтветСОшибкой(
			Запрос,
			405,
			"Method Not Allowed",
			КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
			"Метод HTTP должен быть POST"
		);
		Ответ.Заголовки.Вставить("Allow", "POST");

		Возврат Ответ;
	КонецЕсли;

	ТипСодержимого = _ПроверкаЗапроса.ЗначениеЗаголовка(Запрос.Заголовки, "Content-Type");
	Если Не _ПроверкаЗапроса.ЭтоТипСодержимогоJSON(ТипСодержимого) Тогда
		Возврат ОтветСОшибкой(
			Запрос,
			415,
			"Unsupported Media Type",
			КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
			"Тип содержимого должен быть application/json"
		);
	КонецЕсли;

	ПредельныйРазмерТела = _ПроверкаЗапроса.ПредельныйРазмерТела();
	ПревышенРазмерТела = _ПроверкаЗапроса.РазмерТела(Запрос) > ПредельныйРазмерТела;

	Если Не ПревышенРазмерТела Тогда
		Попытка
			ПодготовитьТелоСОграничением(Запрос, ПредельныйРазмерТела);
			ПревышенРазмерТела = _ПроверкаЗапроса.РазмерТела(Запрос) > ПредельныйРазмерТела;
		Исключение
			ПревышенРазмерТела = ЭтоПревышениеОграниченияСервера(ИнформацияОбОшибке());

			Если Не ПревышенРазмерТела Тогда
				Возврат ОтветСОшибкой(
					Запрос,
					400,
					"Bad Request",
					КодыСтандартныхОшибок.НекорректныеДанные(),
					"Не удалось прочитать тело запроса"
				);
			КонецЕсли;

		КонецПопытки;
	КонецЕсли;

	Если ПревышенРазмерТела Тогда
		Возврат ОтветСОшибкой(
			Запрос,
			413,
			"Content Too Large",
			КодыСтандартныхОшибок.ДанныеСлишкомБольшие(),
			"Тело запроса превышает 65536 байт"
		);
	КонецЕсли;

	Разбор = _ПроверкаЗапроса.Разобрать(Запрос.Тело);
	Если Разбор.Ошибка <> Неопределено Тогда
		Возврат ОтветСОшибкойПроверки(Запрос, Разбор.Ошибка);
	КонецЕсли;

	ОшибкаПроверки = _ПроверкаЗапроса.ПроверитьДанные(Разбор.Данные);
	Если ОшибкаПроверки <> Неопределено Тогда
		Возврат ОтветСОшибкойПроверки(Запрос, ОшибкаПроверки);
	КонецЕсли;

	Запрос.ПараметрыИменные.Вставить("ПроверенныеДанныеЗапроса", Разбор.Данные);

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьТелоСОграничением(Запрос, ПредельныйРазмер)

	Если Запрос.ТелоПоток = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Чтение = Новый ЧтениеДанных(Запрос.ТелоПоток);
	Порции = Новый Массив;
	РазмерТела = 0;

	Пока РазмерТела <= ПредельныйРазмер Цикл
		РазмерПорции = Мин(4096, ПредельныйРазмер + 1 - РазмерТела);
		Порция = Чтение.Прочитать(РазмерПорции).ПолучитьДвоичныеДанные();

		Если Порция.Размер() = 0 Тогда
			Прервать;
		КонецЕсли;

		Порции.Добавить(Порция);
		РазмерТела = РазмерТела + Порция.Размер();
	КонецЦикла;

	Запрос.ТелоДвоичныеДанные = СоединитьДвоичныеДанные(Порции);
	Запрос.Тело = ПолучитьСтрокуИзДвоичныхДанных(Запрос.ТелоДвоичныеДанные);
	Запрос.ТелоПоток = Неопределено;

КонецПроцедуры

Функция ЭтоПревышениеОграниченияСервера(Ошибка)

	// OneScript не предоставляет HTTP-статус нативного исключения Kestrel.
	Правило = Новый ПравилоКлассификацииОшибок()
		.СНативнымТипом("Microsoft.AspNetCore.Server.Kestrel.Core.BadHttpRequestException")
		.НачинаетсяС("Request body too large.")
		.КлассифицируетКак(
			КодыСтандартныхОшибок.ДанныеСлишкомБольшие(),
			"Тело запроса превышает допустимый размер"
		);

	Правила = Новый Массив;
	Правила.Добавить(Правило);

	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПравила(Правила);
	Результат = Классификатор.Классифицировать(Ошибка);

	Возврат Результат <> Неопределено
		И ДиагностикаОшибок.КодОшибки(Результат) = КодыСтандартныхОшибок.ДанныеСлишкомБольшие();

КонецФункции

Функция ЭтоЦелевойЗапрос(Запрос)

	Маршрутизатор = _Поделка.НайтиЖелудь("Маршрутизатор");
	Маршрут = Маршрутизатор.НайтиОбработчикИПараметрыПоПолномуПути(Запрос.Путь);

	Возврат ЗначениеЗаполнено(Маршрут.Действие) И Маршрут.Действие.ШаблонПути = "/api/v2/convert";

КонецФункции

Функция ОтветСОшибкой(Запрос, КодСостояния, ТекстСостояния, КодОшибки, Сообщение)

	Ошибка = _ПроверкаЗапроса.НоваяОшибка(
		КодСостояния,
		ТекстСостояния,
		"тело запроса",
		КодОшибки,
		Сообщение
	);

	Возврат ОтветСОшибкойПроверки(Запрос, Ошибка);

КонецФункции

Функция ОтветСОшибкойПроверки(Запрос, ОшибкаПроверки)

	ФабрикаОтветов = _Поделка.НайтиЖелудь("ФабрикаОтветов");
	Ответ = ФабрикаОтветов.НовыйОтвет();
	Ответ.ИдентификаторЗапроса = Запрос.Идентификатор;
	_ФормированиеОтвета.ЗаписатьОшибку(
		Ответ,
		ОшибкаПроверки.Статус,
		ОшибкаПроверки.ТекстСтатуса,
		ОшибкаПроверки.Ошибка
	);

	Возврат Ответ;

КонецФункции

#КонецОбласти
